# URL du frontend pour les liens dans les e-mails (port 80 = Nginx Docker ; 5173 = npm run dev)
FRONTEND_URL=http://localhost

POSTGRES_PASSWORD=lexdata_postgres_password_dev
RABBITMQ_DEFAULT_USER=lexdata
RABBITMQ_DEFAULT_PASS=lexdata_rabbitmq_password_dev
EUREKA_ADMIN_PASSWORD=lexdata_eureka_admin_password_dev
LEXDATA_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Comptes par défaut créés par lexdata-auth au démarrage (superadmin / agentadmin)
LEXDATA_BOOTSTRAP_SUPER_ADMIN_PASSWORD=superadmin26
LEXDATA_BOOTSTRAP_AGENT_ADMIN_PASSWORD=agentadmin26
SPRING_JPA_HIBERNATE_DDL_AUTO=update

